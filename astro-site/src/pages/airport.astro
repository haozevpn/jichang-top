    price: '￥10.00/月起',
    unlimitedTraffic: false,
    trial: '无',
    reviewLink: '/p/kuaili-review/',
    registerLink: 'https://varnexa.kuailitttt.homes/#/register?code=G56QwHto',
    description: '快狸机场支持专属客户端，提供不限速的高速连接。森狸年付小套餐120元/年，30GB月流量适合轻度使用。完美解锁流媒体与ChatGPT，是稳定可靠的翻墙梯子选择。'
  },
  {
    rank: 3,
    name: '可信云',
    rating: 9.7,
    lineType: '稳定专线',
    tags: ['不限设备数', '无限速', '60GB流量/月', '年付优惠'],
    price: '￥8.00/月起',
    unlimitedTraffic: false,
    trial: '无',
    reviewLink: '/p/kexinyun-review/',
    registerLink: 'https://varnexa.kexintttt.xyz/#/register?code=zcjBlIde',
    description: '可信云机场年费小礼包96元/年，月均8元享受60GB流量。不限制设备数量，无限速度限制，支持多协议订阅，完美解锁Netflix/YouTube等主流流媒体平台。'
  },
  {
    rank: 4,
    name: '边缘节点',
    rating: 9.6,
    lineType: '边缘加速',
    tags: ['不限速', '不限设备数', '45GB流量/月', '限时优惠'],
    price: '￥9.00/月起',
    unlimitedTraffic: false,
    trial: '无',
    reviewLink: '/p/bianyuan-review/',
    registerLink: 'https://zoio.edgenovaaff.cc/#/register?code=Oy1wZvzJ',
    description: '边缘节点机场采用边缘加速技术，限时年付108元/年。提供45GB月流量，不限速不限制设备数，支持Shadowsocks/Trojan协议，适合稳定翻墙需求。'
