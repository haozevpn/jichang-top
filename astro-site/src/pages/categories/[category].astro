---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  // 获取所有分类
  const categories = [...new Set(posts.flatMap(post => post.data.categories))];

  return categories.map(category => {
    const filteredPosts = posts
      .filter(post => post.data.categories.includes(category))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { category },
      props: { category, posts: filteredPosts }
    };
  });
}

const { category, posts } = Astro.props;

// SEO优化：根据分类生成特定的title和description
const seoConfig: Record<string, { title: string; description: string }> = {
  '机场测评': {
    title: `机场测评 - 2026年稳定机场推荐与梯子推荐详细评测 | 机场TOP`,
    description: `专业的机场测评文章合集，包含IEPL专线机场推荐、稳定机场推荐、高速梯子推荐的详细测评。涵盖速界、快狸、可信云、极连云等优质机场评测，帮您选择最适合的科学上网服务。`
  },
  '科学上网指南': {
    title: `科学上网指南 - 梯子推荐教程与VPN推荐使用技巧 | 机场TOP`,
    description: `全面的科学上网指南与梯子推荐教程，涵盖机场选购、节点配置、防封锁技巧。提供Clash、Shadowrocket等客户端使用教程，以及VPN推荐对比分析，助您安全稳定上网。`
  },
  '新手指南': {
    title: `新手指南 - 机场推荐入门教程与梯子推荐快速上手 | 机场TOP`,
    description: `专为新手打造的机场推荐入门指南，包含稳定机场推荐选择、梯子推荐配置教程、常见问题解答。从零开始学习科学上网，快速掌握VPN推荐与代理节点使用技巧。`
  }
};

const pageTitle = seoConfig[category]?.title || `${category} - 机场TOP稳定机场推荐`;
const pageDescription = seoConfig[category]?.description || `浏览所有关于 ${category} 的文章，涵盖机场推荐、稳定机场推荐、梯子推荐等专业内容。`;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="mb-12 text-center">
      <div class="inline-block px-4 py-2 bg-[var(--color-accent-tint)] text-[var(--color-accent)] rounded-full mb-4">
        分类
      </div>
      <h1 class="text-4xl md:text-5xl font-serif mb-4">
        {category}
      </h1>
      <p class="text-lg text-[var(--color-muted)]">
        共 {posts.length} 篇文章
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid gap-8">
      {posts.map((post) => (
        <article class="card p-6">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex-1">
              <time class="text-sm text-[var(--color-muted)] mb-2 block">
                {formatDate(post.data.date)}
              </time>

              <h2 class="text-2xl font-serif mb-3">
                <a
                  href={`/p/${post.data.slug || post.id.replace(/\.md$/, "")}`}
                  class="text-[var(--color-ink)] hover:text-[var(--color-accent)] no-underline transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="text-[var(--color-muted)] mb-3 leading-relaxed">
                  {post.data.description}
                </p>
              )}

              {post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 4).map((tag) => (
                    <a
                      href={`/tags/${tag}`}
                      class="text-xs px-3 py-1 bg-[var(--color-surface)] border border-[var(--color-warm-border)] rounded-full text-[var(--color-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] no-underline transition-colors"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )}
            </div>

            {post.data.rating && (
              <div class="flex items-center justify-center md:justify-end">
                <div class="text-center px-6 py-3 bg-[var(--color-accent-tint)] rounded-lg">
                  <div class="text-3xl font-bold text-[var(--color-accent)]">
                    {post.data.rating.toFixed(1)}
                  </div>
                  <div class="text-xs text-[var(--color-muted)]">评分</div>
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</MainLayout>
