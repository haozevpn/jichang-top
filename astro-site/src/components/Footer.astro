---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 bg-[var(--color-charcoal)] text-white py-12">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="text-lg font-serif mb-4">关于本站</h3>
        <p class="text-sm text-gray-300 leading-relaxed">
          专注于机场评测与科学上网指南，为您提供最真实、最客观的机场推荐。
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-serif mb-4">快速链接</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-gray-300 hover:text-[var(--color-accent)] no-underline">首页</a></li>
          <li><a href="/airport" class="text-gray-300 hover:text-[var(--color-accent)] no-underline">机场推荐</a></li>
          <li><a href="/categories/机场测评" class="text-gray-300 hover:text-[var(--color-accent)] no-underline">机场测评</a></li>
          <li><a href="/about" class="text-gray-300 hover:text-[var(--color-accent)] no-underline">关于</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-serif mb-4">联系方式</h3>
        <p class="text-sm text-gray-300">
          邮箱：contact@jichang-top.com
        </p>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-700 text-center text-sm text-gray-400">
      <p>&copy; {currentYear} 机场TOP. All rights reserved.</p>
    </div>
  </div>
</footer>
