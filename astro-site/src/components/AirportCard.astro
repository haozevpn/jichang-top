---
interface Props {
  rank: number;
  name: string;
  rating: number;
  lineType: string;
  tags: string[];
  price: string;
  unlimitedTraffic: boolean;
  trial: string;
  reviewLink: string;
  registerLink: string;
  description: string;
}

const {
  rank,
  name,
  rating,
  lineType,
  tags,
  price,
  unlimitedTraffic,
  trial,
  reviewLink,
  registerLink,
  description
} = Astro.props;
---

<div class="airport-card card p-6 mb-8">
  <div class="flex items-start gap-4 mb-4">
    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-hover)] rounded-full flex items-center justify-center text-white font-bold text-xl">
      {rank}
    </div>
    <div class="flex-1">
      <h3 class="text-2xl font-serif mb-2">{name}</h3>
      <div class="flex items-center gap-3 mb-3">
        <span class="text-2xl font-bold text-[var(--color-accent)]">{rating} ★</span>
        <span class="px-3 py-1 bg-[var(--color-accent-tint)] text-[var(--color-accent)] text-sm rounded-full">
          {lineType}
        </span>
      </div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-4 mb-4">
    <div>
      <span class="text-sm text-[var(--color-muted)]">起步价格：</span>
      <span class="font-semibold text-lg">{price}</span>
    </div>
    <div>
      <span class="text-sm text-[var(--color-muted)]">不限时流量：</span>
      {unlimitedTraffic ? (
        <span class="text-green-600 font-semibold">✅ 支持</span>
      ) : (
        <span class="text-gray-500">❌ 不支持</span>
      )}
    </div>
  </div>

  <div class="flex flex-wrap gap-2 mb-4">
    {tags.map((tag) => (
      <span class="text-xs px-3 py-1 bg-[var(--color-surface)] border border-[var(--color-warm-border)] rounded-full text-[var(--color-muted)]">
        {tag}
      </span>
    ))}
  </div>

  <p class="text-[var(--color-muted)] mb-4 leading-relaxed">{description}</p>

  <div class="flex flex-col sm:flex-row gap-3">
    <a
      href={registerLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary flex-1 text-center"
    >
      🚀 前往官网注册
    </a>
    <a
      href={reviewLink}
      class="btn-secondary flex-1 text-center"
    >
      📝 查看详细测评
    </a>
  </div>
</div>
