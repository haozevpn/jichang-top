---
// SEO友好的内部链接组件
interface Link {
  title: string;
  href: string;
  description?: string;
}

interface Props {
  title?: string;
  links: Link[];
}

const { title = "相关推荐", links } = Astro.props;
---

<div class="internal-links card p-6 my-8 bg-gradient-to-br from-[var(--color-surface)] to-[var(--color-surface-white)]">
  <h3 class="text-xl font-serif mb-4 flex items-center gap-2">
    <span class="text-[var(--color-accent)]">🔗</span>
    {title}
  </h3>
  <ul class="space-y-3">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="flex flex-col p-3 rounded-lg hover:bg-[var(--color-accent-tint)] transition-colors group no-underline"
        >
          <span class="text-[var(--color-ink)] font-medium group-hover:text-[var(--color-accent)] transition-colors">
            → {link.title}
          </span>
          {link.description && (
            <span class="text-sm text-[var(--color-muted)] mt-1">
              {link.description}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>
